# GraphRAG Local Ollama — environment configuration
# Copy this file to .env and edit as needed

# Ollama model for LLM inference
LLM_PROVIDER=ollama
LLM_HOST=http://172.16.125.141:11434
# LLM_HOST=http://localhost:11434
LLM_MODEL=qwen3.5:9b
LLM_MAX_TOKEN_SIZE=8000
LLM_MAX_ASYNC=2
LLM_REQUEST_STAGGER_MS=500
LLM_EXTRACT_MAX_RETRIES=2
LLM_EXTRACT_RETRY_BACKOFF_MS=500
LLM_EXTRACT_SKIP_ON_ERROR=1
OLLAMA_THINK=False
EMBED_PROVIDER=ollama
EMBED_MODEL=qwen3-embedding:latest
EMBED_MODEL_DIM=4096
MAX_PARALLEL_INSERT=1
WORKING_DIR=../output/LiHua-World
DATA_PATH=./dataset/LiHua-World/data/
QUERY_PATH=./dataset/LiHua-World/qa/query_set.csv
OUTPUT_PATH=./logs/Default_output.csv

GRAPH_STORAGE=Neo4JStorage
# GRAPH_STORAGE=Neo4JStorage

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

REQUEST_TIMEOUT=600.0

# Fuzzy Logic Alignment Settings
# ENABLE_FUZZY_LOGIC=False
ENABLE_FUZZY_LOGIC=True
FL_USE_LLM=0
FL_THRES_SIM=0.75
FL_THRES_MAP=0.75



